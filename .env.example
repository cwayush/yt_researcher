# yt_researcher - root environment configuration
# Copy this file to .env at the repository root and fill in real values.
# Never commit .env.

# ------------------------------------------------------------------------------
# Backend

# Google: embeddings (required)
GOOGLE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"
GOOGLE_EMBEDDING_DIMENSIONS=768         

# Groq: answer generation (required)
GROQ_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="openai/gpt-oss-120b"

# Qdrant: child chunk vectors (required)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""                       
QDRANT_COLLECTION="youtube_chunks"      

# PostgreSQL: parent chunks and video index state (required)
DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/yt_researcher"

# Indexing freshness (required)
FRESHNESS_CHECK_DAYS=30                  

# Retrieval tuning (required)
RRF_K=60                                 
RETRIEVAL_CANDIDATE_LIMIT=20             
RETRIEVAL_FINAL_LIMIT=5                  
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANKER_MIN_SCORE=0.5                  

# Optional
HF_TOKEN=""                              
LANGCHAIN_API_KEY=""                     
LANGCHAIN_PROJECT=""
SENTENCE_PAUSE_THRESHOLD=2.0             
DEBUG=false                              

# Browser origins allowed to call the API, comma separated.
# Must include the Vite dev server origin or the browser blocks every request.
CORS_ALLOW_ORIGINS="http://localhost:5173, http://127.0.0.1:5173"


# ------------------------------------------------------------------------------
# Frontend

# Base URL of the yt_backend API, including the /api/v1 version prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1
