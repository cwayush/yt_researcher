# Copy to .env and fill in real values. Never commit .env.

# Google: embeddings (required)
GOOGLE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"
GOOGLE_EMBEDDING_DIMENSIONS=768          # must match the Qdrant collection's vector size

# Groq: answer generation (required)
GROQ_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="openai/gpt-oss-120b"

# Qdrant: child chunk vectors (required) 
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""                        # optional; leave empty for a local instance
QDRANT_COLLECTION="youtube_chunks"       # optional, default: youtube_chunks

# PostgreSQL: parent chunks and video index state (required)
DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/yt_researcher"

# Indexing freshness (required)
FRESHNESS_CHECK_DAYS=30                  # days before an indexed video's transcript is re-checked

# Retrieval tuning (required)
RRF_K=60                                 # Reciprocal Rank Fusion constant
RETRIEVAL_CANDIDATE_LIMIT=20             # chunks fetched per retriever before fusion
RETRIEVAL_FINAL_LIMIT=5                  # chunks kept after reranking
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANKER_MIN_SCORE=0.5                   # normalized 0-1 reranker score; below this, the answer is treated as out of scope

# Optional
HF_TOKEN=""                              # only needed if the reranker model is gated
LANGCHAIN_API_KEY=""                     # LangSmith tracing
LANGCHAIN_PROJECT=""
SENTENCE_PAUSE_THRESHOLD=2.0             # optional, default: 2.0 seconds
DEBUG=false                              # optional, default: false
